{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GuAsk",
  "version": "0.1.1",
  "identifier": "com.gu.guask",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "security": { "csp": null },
    "windows": [
      {
        "label": "popup",
        "url": "popup.html",
        "title": "GuAsk",
        "width": 440,
        "height": 380,
        "minWidth": 320,
        "minHeight": 220,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true
      },
      {
        "label": "bubble",
        "url": "bubble.html",
        "title": "GuAsk",
        "width": 30,
        "height": 30,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false
      },
      {
        "label": "shot",
        "url": "shot.html",
        "title": "GuAsk 截图",
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false
      },
      {
        "label": "frame",
        "url": "frame.html",
        "title": "GuAsk 选区",
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false
      },
      {
        "label": "settings",
        "url": "settings.html",
        "title": "GuAsk 设置",
        "width": 560,
        "height": 640,
        "visible": false,
        "center": true
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE4RDY2QjYzQ0M5NzVGODgKUldTSVg1Zk1ZMnZXR0VmRzBoWXVTQ2JWWWZMVGVxZ2FuREJ6NTB3Qkx1cWNSMXJYZDJ1UUp3U0EK",
      "endpoints": ["https://github.com/xiaoguzuiniu/GuAsk/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "Gu",
    "shortDescription": "划词翻译 / 提问 / 截图提问",
    "windows": { "nsis": { "languages": ["SimpChinese"], "installMode": "currentUser" } },
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
