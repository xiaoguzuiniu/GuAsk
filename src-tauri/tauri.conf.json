{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GuAsk",
  "version": "0.1.0",
  "identifier": "com.gu.guask",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "security": { "csp": null },
    "windows": [
      {
        "label": "popup",
        "url": "popup.html",
        "title": "GuAsk",
        "width": 440,
        "height": 380,
        "minWidth": 320,
        "minHeight": 220,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true
      },
      {
        "label": "bubble",
        "url": "bubble.html",
        "title": "GuAsk",
        "width": 30,
        "height": 30,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false
      },
      {
        "label": "shot",
        "url": "shot.html",
        "title": "GuAsk 截图",
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false
      },
      {
        "label": "settings",
        "url": "settings.html",
        "title": "GuAsk 设置",
        "width": 560,
        "height": 640,
        "visible": false,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
